{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brepsi Brain",
  "version": "1.3.1",
  "identifier": "com.brepsibrain.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Brepsi Brain",
        "url": "index.html",
        "backgroundColor": "#101117",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Brepsi Brain"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/brepsi-brain.ico", "icons/icon.png"]
  }
}
